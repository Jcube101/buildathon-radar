ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMAIL_ADDRESS=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

TRACKER_SECRET=generate_with_python3_-c_"import secrets; print(secrets.token_hex(32))"

TYPESAFE_API_KEY=your_typesafe_api_key_here
# Jev pre-filter ahead of the Claude call. Off by default; see triage.py.
# Flip to true only after reviewing a scripts/triage_preview.py run.
ENABLE_JEV_TRIAGE=false

# Dependencies: pip install -r requirements.txt
